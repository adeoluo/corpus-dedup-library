flowchart LR
    classDef edge     fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef control  fill:#0EA5E9,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef obs      fill:#CBD5E1,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    subgraph Interfaces["Interfaces (no stored corpus)"]
        direction TB
        Client([HTTP client]):::edge
        CLI(["CLI<br/>dedup, quality, report"]):::edge
        Router["Router<br/>/dedup, /quality"]:::edge
        Validate["Validation<br/>doc count and size"]:::control
        CLI ~~~ Client --> Router --> Validate
    end

    subgraph Core["Dedup and quality"]
        direction TB
        Sign["Shingle + MinHash<br/>hashed word k-grams"]:::core
        LSH["LSH banding<br/>16 bands x 4 rows"]:::core
        Verify["Jaccard threshold<br/>estimate or exact"]:::control
        Cluster["Union-find<br/>keep lowest id"]:::core
        Rules["Quality rules<br/>length, symbols, repeats"]:::control
        Sign --> LSH --> Verify --> Cluster ~~~ Rules
    end

    subgraph Rust["Rust core (bit-exact)"]
        direction TB
        RustCore[["corpus_dedup_rs<br/>rayon, GIL released"]]:::core
        RustCLI(["corpus-dedup CLI<br/>JSONL stream"]):::edge
        RustCore ~~~ RustCLI
    end

    subgraph State["Data and state"]
        direction TB
        Signatures[("Signatures<br/>per document")]:::data
        Buckets[("Band buckets<br/>hash per band")]:::data
        Corpus[("Synthetic corpus<br/>known duplicates")]:::data
        Signatures ~~~ Buckets ~~~ Corpus
    end

    subgraph Obs["Evaluation and outputs"]
        direction TB
        Result["DedupResult<br/>keep, drop, pairs"]:::obs
        QReport["QualityReport<br/>passed + reasons"]:::obs
        Detect["DetectionReport<br/>precision, recall"]:::obs
        Metrics["ServiceMetrics<br/>Prometheus"]:::obs
        Result ~~~ QReport ~~~ Detect ~~~ Metrics
    end

    Interfaces -->|documents| Core
    Interfaces -->|backend=rust| Rust
    Core -.->|signatures, buckets| State
    Rust -.->|same signatures| State
    Core -->|keep, drop, reasons| Obs
